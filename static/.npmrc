# Security baseline: do not run dependency lifecycle scripts (preinstall/install/postinstall/prepare)
# during `pnpm install`. Defense-in-depth on top of pnpm 10's allowlist model
# (see pnpm.onlyBuiltDependencies in package.json for explicitly-allowed build scripts).
# Explicit `pnpm run <script>` (build, test, lint) is unaffected.
ignore-scripts=true
